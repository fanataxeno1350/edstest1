import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const section = document.createElement('section');
  section.classList.add('banner-section');

  [...block.children].forEach((row) => {
    const wrapperDiv = document.createElement('div');
    moveInstrumentation(row, wrapperDiv);
    wrapperDiv.classList.add('banner-position-relative', 'banner-boing', 'banner-section__wrapper');

    const ctaDiv = document.createElement('div');
    ctaDiv.classList.add('banner-position-absolute', 'banner-start-50', 'banner-translate-middle-x', 'banner-w-100', 'banner-boing__banner--cta');

    const innerCtaDiv = document.createElement('div');
    innerCtaDiv.classList.add('banner-cta');

    // Assuming the CTA content is directly within the row's cells if any
    // Since the provided JSON has no fields, we'll just replicate the structure.
    // If there were link/text fields, we would extract them here.
    [...row.children].forEach((cell) => {
      // For this specific block, the content is mostly structural.
      // If there were actual content like images or links in the cell,
      // we would process them here.
      // Example: const link = cell.querySelector('a');
      // if (link) { innerCtaDiv.append(link); }
      innerCtaDiv.append(...cell.children);
    });

    ctaDiv.append(innerCtaDiv);
    wrapperDiv.append(ctaDiv);
    section.append(wrapperDiv);
  });

  block.textContent = '';
  block.append(section);
}
