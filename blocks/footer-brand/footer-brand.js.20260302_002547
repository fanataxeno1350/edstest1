import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // Primary Brand Section
  const primaryBrandSection = document.createElement('section');
  primaryBrandSection.className = 'footer-brand--primary';
  primaryBrandSection.style.backgroundColor = '';

  const primaryContainer = document.createElement('div');
  primaryContainer.className = 'footer-brand--container';
  primaryBrandSection.append(primaryContainer);

  const primaryContent = document.createElement('div');
  primaryContent.className = 'footer-brand--primary--content footer-d-flex footer-flex-column footer-flex-md-row footer-justify-content-md-between footer-align-items-center';
  primaryContainer.append(primaryContent);

  const brandLeft = document.createElement('section');
  brandLeft.className = 'footer-brand--left footer-d-flex footer-gap-16 footer-px-10 footer-align-items-center footer-justify-content-center';
  primaryContent.append(brandLeft);

  const brandRight = document.createElement('section');
  brandRight.className = 'footer-brand--right';
  primaryContent.append(brandRight);

  const brandNavbar = document.createElement('nav');
  brandNavbar.className = 'footer-brand--navbar footer-d-grid footer-d-md-flex';
  brandNavbar.setAttribute('aria-label', 'footer navbar');
  brandRight.append(brandNavbar);

  const brandNavbarLeft = document.createElement('div');
  brandNavbarLeft.className = 'footer-brand--navbar--left footer-d-flex footer-flex-column footer-flex-md-row';
  brandNavbar.append(brandNavbarLeft);

  const brandNavbarRight = document.createElement('div');
  brandNavbarRight.className = 'footer-brand--navbar--right footer-d-flex footer-flex-column footer-flex-md-row';
  brandNavbar.append(brandNavbarRight);

  // Secondary Brand Section
  const secondaryBrandSection = document.createElement('section');
  secondaryBrandSection.className = 'footer-brand--secondary';
  secondaryBrandSection.style.backgroundColor = '';

  const secondaryContainer = document.createElement('div');
  secondaryContainer.className = 'footer-brand--container';
  secondaryBrandSection.append(secondaryContainer);

  const secondaryContent = document.createElement('div');
  secondaryContent.className = 'footer-brand--secondary--content footer-d-flex footer-flex-column footer-justify-content-md-between footer-align-items-center';
  secondaryContainer.append(secondaryContent);

  const secondaryBrandRight = document.createElement('section');
  secondaryBrandRight.className = 'footer-brand--right footer-d-flex footer-flex-column footer-pb-5';
  secondaryContent.append(secondaryBrandRight);

  const socialMediaTitle = document.createElement('h3');
  socialMediaTitle.className = 'footer-social_media--title';
  socialMediaTitle.textContent = 'Follow Us On';
  secondaryBrandRight.append(socialMediaTitle);

  const socialMediaList = document.createElement('ul');
  socialMediaList.className = 'footer-brand--right--list footer-d-flex footer-align-items-center footer-justify-content-center footer-px-10 footer-flex-wrap';
  secondaryBrandRight.append(socialMediaList);

  const secondaryBrandLeft = document.createElement('section');
  secondaryBrandLeft.className = 'footer-brand--left footer-py-5 footer-d-flex footer-flex-column footer-gap-3';
  secondaryContent.append(secondaryBrandLeft);

  const secondaryBrandLeftList = document.createElement('ul');
  secondaryBrandLeftList.className = 'footer-brand--left--list footer-d-flex footer-align-items-center footer-justify-content-center footer-flex-wrap';
  secondaryBrandLeft.append(secondaryBrandLeftList);

  const copyrightDiv = document.createElement('div');
  copyrightDiv.className = 'footer-brand--left--copyright footer-text-center';
  secondaryBrandLeft.append(copyrightDiv);

  const copyrightSpan = document.createElement('span');
  copyrightSpan.className = 'footer-brand--left--text footer-text-white';
  copyrightDiv.append(copyrightSpan);

  // Process block children
  let linkListCounter = 0;
  let socialLinkCounter = 0;
  let bottomLinkCounter = 0;

  [...block.children].forEach((row) => {
    const cells = [...row.children];
    const type = cells[0].textContent.trim();
    const contentCell = cells[1];

    moveInstrumentation(row, row);

    if (type === 'Primary Logo') {
      const link = contentCell.querySelector('a');
      const img = contentCell.querySelector('img');
      if (link && img) {
        const logoLink = document.createElement('a');
        logoLink.href = link.href;
        logoLink.target = '_blank';
        logoLink.className = 'footer-brand--logo footer-d-inline-block footer-analytics_cta_click';
        logoLink.setAttribute('data-cta-region', 'Footer');
        logoLink.setAttribute('aria-label', img.alt || 'Logo');

        const optimizedPic = createOptimizedPicture(img.src, img.alt);
        moveInstrumentation(img, optimizedPic.querySelector('img'));
        optimizedPic.querySelector('img').className = 'footer-object-fit-contain footer-w-100 footer-h-100 footer-no-rendition';
        optimizedPic.querySelector('img').setAttribute('loading', 'lazy');
        logoLink.append(optimizedPic);
        brandLeft.append(logoLink);
      }
    } else if (type === 'Secondary Logo') {
      const img = contentCell.querySelector('img');
      if (img) {
        const secondaryLogoDiv = document.createElement('div');
        secondaryLogoDiv.className = 'footer-brand--secondary--logo footer-d-inline-block';

        const optimizedPic = createOptimizedPicture(img.src, img.alt);
        moveInstrumentation(img, optimizedPic.querySelector('img'));
        optimizedPic.querySelector('img').className = 'footer-object-fit-contain footer-w-100 footer-no-rendition';
        optimizedPic.querySelector('img').setAttribute('loading', 'lazy');
        secondaryLogoDiv.append(optimizedPic);
        brandLeft.append(secondaryLogoDiv);
      }
    } else if (type === 'Footer Link Lists') {
      const footerListDiv = document.createElement('div');
      footerListDiv.className = 'footer-footerlist';

      const ul = document.createElement('ul');
      ul.className = 'footer-list footer-d-flex footer-align-items-center footer-justify-content-center footer-align-items-md-start footer-flex-column';
      footerListDiv.append(ul);

      const links = contentCell.querySelectorAll('li');
      links.forEach((linkItem) => {
        const li = document.createElement('li');
        li.className = 'footer-list--item';
        moveInstrumentation(linkItem, li);

        const link = linkItem.querySelector('a');
        if (link) {
          const newLink = document.createElement('a');
          newLink.href = link.href;
          newLink.textContent = link.textContent;
          newLink.className = 'footer-cta-analytics footer-analytics_cta_click footer-list--item--link footer-d-inline-block';
          newLink.setAttribute('data-link-region', 'Footer List');
          if (link.target) {
            newLink.target = link.target;
          }
          li.append(newLink);
        }
        ul.append(li);
      });

      if (linkListCounter < 2) {
        brandNavbarLeft.append(footerListDiv);
      } else {
        brandNavbarRight.append(footerListDiv);
      }
      linkListCounter += 1;
    } else if (type === 'Footer Social Links') {
      const li = document.createElement('li');
      li.className = 'footer-brand--right--item footer-d-flex footer-justify-content-center footer-align-items-center';
      moveInstrumentation(row, li);

      const link = contentCell.querySelector('a');
      const img = contentCell.querySelector('img');

      if (link && img) {
        const socialLink = document.createElement('a');
        socialLink.href = link.href;
        socialLink.target = '_blank';
        socialLink.className = 'footer-brand--right--link footer-d-flex footer-justify-content-center footer-align-items-center footer-analytics_cta_click';
        socialLink.setAttribute('data-cta-region', 'Footer');
        socialLink.setAttribute('data-cta-label', `footer-${link.dataset.platformName || 'social'}`);
        socialLink.setAttribute('data-platform-name', link.dataset.platformName || '');
        socialLink.setAttribute('data-social-linktype', 'follow');

        const optimizedPic = createOptimizedPicture(img.src, img.alt || link.dataset.platformName);
        moveInstrumentation(img, optimizedPic.querySelector('img'));
        optimizedPic.querySelector('img').className = 'footer-object-fit-contain footer-w-100 footer-h-100 footer-no-rendition';
        optimizedPic.querySelector('img').setAttribute('loading', 'lazy');
        optimizedPic.querySelector('img').setAttribute('aria-label', link.dataset.platformName);
        socialLink.append(optimizedPic);
        li.append(socialLink);
        socialMediaList.append(li);
      }
      socialLinkCounter += 1;
    } else if (type === 'Footer Bottom Links') {
      const li = document.createElement('li');
      li.className = 'footer-brand--left--item footer-foot_link';
      moveInstrumentation(row, li);

      const link = contentCell.querySelector('a');
      if (link) {
        const bottomLink = document.createElement('a');
        bottomLink.href = link.href;
        bottomLink.textContent = link.textContent;
        bottomLink.className = 'footer-brand--left--link footer-analytics_cta_click';
        bottomLink.setAttribute('data-cta-region', 'Footer');
        if (link.target) {
          bottomLink.target = link.target;
        }
        li.append(bottomLink);
        secondaryBrandLeftList.append(li);
      }
      bottomLinkCounter += 1;
    } else if (type === 'Copyright Text') {
      copyrightSpan.innerHTML = contentCell.innerHTML;
    }
  });

  block.textContent = '';
  block.append(primaryBrandSection, secondaryBrandSection);
}
