.footer-brand-primary {
  padding: 0px 1rem 1rem; /* Equivalent to 0 16px 16px assuming 16px base */
  background-position: 50% 50%;
  background-repeat: no-repeat;
  background-size: cover;
}
.footer-brand-primary-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  row-gap: 2rem; /* Equivalent to 32px assuming 16px base */
  column-gap: 7.5rem; /* Equivalent to 120px assuming 16px base */
}
.footer-brand-left {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3.75rem; /* Equivalent to 60px assuming 16px base */
  padding: 0px 2.25rem; /* Equivalent to 0 36px assuming 16px base */
}
.footer-brand-logo {
  display: inline-block;
  height: 3.9375rem; /* Equivalent to 63px assuming 16px base */
  min-width: 3.375rem; /* Equivalent to 54px assuming 16px base */
}
.footer-object-fit-contain {
  object-fit: contain;
}
.footer-w-100 {
  width: 100%;
}
.footer-h-100 {
  height: 100%;
}
.footer-brand-secondary-logo {
  display: inline-block;
  max-height: 100%;
  min-width: 4.375rem; /* Equivalent to 70px assuming 16px base */
  width: 4.375rem; /* Equivalent to 70px assuming 16px base */
}
.footer-brand-right {
  width: 100%;
}
.footer-brand-navbar {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
.footer-list-wrapper {
  height: 50%;
}
.footer-list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2.25rem; /* Equivalent to 36px assuming 16px base */
  height: 100%;
  list-style: none;
  padding: 0;
}
.footer-list-item {
  width: 100%;
}
.footer-list-item-link {
  color: #fff;
  cursor: pointer;
  font-size: 0.75rem; /* Equivalent to 12px assuming 16px base */
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
  white-space: normal;
  display: inline-block;
}
.footer-list-item-link:hover {
  text-decoration: underline;
}
.footer-brand-navbar-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2.25rem; /* Equivalent to 36px assuming 16px base */
  padding-right: 2rem; /* Equivalent to 32px assuming 16px base */
  border-right: 1px solid rgba(255, 255, 255, 0.302);
  width: 100%;
}
.footer-brand-navbar-left .footer-list-item {
  text-align: left;
}
.footer-brand-navbar-right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2.25rem; /* Equivalent to 36px assuming 16px base */
  padding-left: 2rem; /* Equivalent to 32px assuming 16px base */
  width: 100%;
}
.footer-brand-navbar-right .footer-list-wrapper:last-child .footer-list {
  border: 0;
}
.footer-brand-secondary {
  padding: 1rem 1.5rem; /* Equivalent to 16px 24px assuming 16px base */
}
.footer-container {
  padding: 0;
  width: 100%;
}
.footer-brand-secondary-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 1.5rem; /* Equivalent to 24px assuming 16px base */
}
.footer-brand-right-social {
  display: flex;
  flex-direction: column;
  padding-bottom: 1rem; /* Equivalent to 16px assuming 16px base */
}
.footer-social-media-title {
  color: #fff;
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  font-weight: 700;
  line-height: 2rem; /* Equivalent to 32px assuming 16px base */
  padding-bottom: 1.25rem; /* Equivalent to 20px assuming 16px base */
  text-align: center;
}
.footer-brand-right-list {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem; /* Equivalent to 16px assuming 16px base */
  padding: 0px 2.25rem; /* Equivalent to 0 36px assuming 16px base */
  flex-wrap: wrap;
  list-style: none;
}
.footer-brand-right-item {
  display: flex;
  justify-content: center;
  align-items: center;
}
.footer-brand-right-link {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 2.6875rem; /* Equivalent to 43px assuming 16px base */
  width: 2.6875rem; /* Equivalent to 43px assuming 16px base */
  transition: transform 0.2s linear;
}
.footer-brand-right-link:hover {
  transform: scale(1.3334);
}
.footer-brand-left-copyright {
  display: flex;
  flex-direction: column;
  gap: 0.5rem; /* Equivalent to 8px assuming 16px base */
  padding: 1rem 0px; /* Equivalent to 16px 0 assuming 16px base */
}
.footer-brand-left-list {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  list-style: none;
}
.footer-brand-left-item {
  padding: 0px 1.5rem; /* Equivalent to 0 24px assuming 16px base */
  border-right: 0.125rem solid rgba(255, 255, 255, 0.302);
}
.footer-brand-left-item:first-child {
  padding-left: 0;
}
.footer-brand-left-item.footer-foot-link:last-of-type {
  border: 0;
}
.footer-brand-left-link {
  color: #fff;
  display: inline-block;
  font-size: 1.25rem; /* Equivalent to 20px assuming 16px base */
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  text-decoration: none;
}
.footer-brand-left-link:hover {
  text-decoration: underline;
}
.footer-brand-left-copyright-text {
  text-align: center;
}
.footer-brand-left-text {
  color: #fff;
  font-size: 0.75rem; /* Equivalent to 12px assuming 16px base */
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
}

@media (max-width: 768px) {
  .footer-brand-primary-content {
    align-items: center;
    justify-content: center;
  }
  .footer-brand-left {
    min-height: 55px;
  }
  .footer-brand-navbar-left {
    border-right: 0;
    padding-right: 0;
  }
  .footer-brand-right-list {
    min-height: 40px;
  }
}
