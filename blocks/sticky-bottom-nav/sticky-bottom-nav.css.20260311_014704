.stickyNavigation-trans-pop-up {
  --bs-gutter-x: 0;
  --bs-gutter-y: 0;
  background: #000000;
  display: none;
  height: 100vh;
  margin-left: auto;
  margin-right: auto;
  max-width: 33.75rem; /* Equivalent to 540px assuming 16px base */
  opacity: 0.8;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 9999;
}

.stickyNavigation-sticky-bottom-nav {
  border-radius: 1rem 1rem 0 0; /* Equivalent to 16px */
  box-shadow: 0.125rem -0.25rem 1rem 0 rgba(0, 0, 0, 0.431); /* Equivalent to 2px -4px 16px */
  height: 4.375rem; /* Equivalent to 70px */
  padding: 0.625rem 0; /* Equivalent to 10px */
  z-index: 997;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #aa1f30;
}

.stickyNavigation-sticky-bottom-nav__list {
  list-style: none;
  display: flex;
  justify-content: space-around;
  align-items: center;
  flex-grow: 1;
}

.stickyNavigation-sticky-bottom-nav__item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stickyNavigation-sticky-bottom-nav__link {
  color: #ffffff;
  display: block;
  text-decoration: none;
  transition: color 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.125rem; /* Equivalent to 2px */
}

.stickyNavigation-sticky-bottom-nav__link.active {
  color: #f6bb00;
}

.stickyNavigation-sticky-bottom-nav__link.active::after {
  background-color: #f6bb00;
  border: 0.070625rem; /* Equivalent to 1.13px */
  bottom: -0.3125rem; /* Equivalent to -5px */
  content: "";
  display: block;
  height: 0.0625rem; /* Equivalent to 1px */
  left: 50%;
  position: absolute;
  transform: translateX(-50%);
  width: 0.625rem; /* Equivalent to 10px */
}

.stickyNavigation-sticky-bottom-nav__icon {
  display: block;
  height: 1.125rem; /* Equivalent to 18px */
  width: 1.125rem; /* Equivalent to 18px */
  transition: filter 0.3s ease, -webkit-filter 0.3s ease;
}

.stickyNavigation-sticky-bottom-nav__label {
  color: #ffffff;
  display: block;
  font-size: 0.75rem; /* Equivalent to 12px assuming 16px base */
  font-weight: 400;
  line-height: 0.9rem; /* Equivalent to 14.4px assuming 16px base */
}
