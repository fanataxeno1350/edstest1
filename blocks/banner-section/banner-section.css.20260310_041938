.banner-section {
  display: block;
  position: static;
  overflow: visible;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
}
.banner-section__wrapper {
  padding-inline: 0.046875rem; /* Equivalent to 0.75px assuming 16px base */
  position: relative;
  display: block;
  overflow: visible;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  width: 100%;
  height: 100%;
}
.banner-section__wrapper .banner-cta-wrapper {
  bottom: 1.875rem; /* Equivalent to 30px assuming 16px base */
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  display: block;
  overflow: visible;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
}
@media (min-width: 540px) {
  .banner-section__wrapper .banner-cta-wrapper .banner-cmp-button__text {
    width: 50% !important;
  }
}
.banner-video-wrapper {
  display: block;
  position: static;
  overflow: visible;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  width: 100%;
  height: 100%;
}
.banner-video-wrapper .banner-video {
  border-radius: 0.5rem; /* Equivalent to 8px assuming 16px base */
  display: inline;
  position: static;
  overflow: clip;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
}
.banner-video-wrapper .banner-video-controls {
  display: flex;
  position: absolute;
  overflow: visible;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}
.banner-video-wrapper .banner-video-controls .banner-video-icon {
  display: none;
  position: static;
  overflow: hidden;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  height: 3rem; /* Equivalent to 48px assuming 16px base */
  width: 3rem; /* Equivalent to 48px assuming 16px base */
  appearance: none;
  background-color: transparent;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}
.banner-video-wrapper .banner-video-controls .banner-icon-pause {
  display: flex;
}
.banner-video-wrapper .banner-mute-icon {
  bottom: 0.8125rem; /* Equivalent to 13px assuming 16px base */
  right: 0.6875rem; /* Equivalent to 11px assuming 16px base */
  display: flex;
  position: absolute;
  overflow: visible;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  justify-content: center;
  align-items: center;
  cursor: pointer;
  z-index: 2;
}
.banner-video-wrapper .banner-mute-icon .banner-video-icon-volume {
  height: 1.5rem; /* Equivalent to 24px assuming 16px base */
  width: 1.5rem; /* Equivalent to 24px assuming 16px base */
  display: flex;
  position: static;
  overflow: hidden;
  color: #212529;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5; /* Equivalent to 24px assuming 16px base */
  appearance: none;
  background-color: transparent;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}
.banner-video-wrapper .banner-mute-icon .banner-icon-mute {
  display: none;
}
.banner-video-wrapper .banner-mute-icon .banner-icon-unmute {
  display: none;
}
.banner-video-wrapper .banner-mute-icon .banner-no-audio-icon {
  display: flex;
}
