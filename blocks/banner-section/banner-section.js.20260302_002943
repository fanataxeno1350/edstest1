import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const wrapper = document.createElement('div');
  wrapper.classList.add('banner-section__wrapper', 'banner-position-relative', 'banner-boing');

  const videoWrapper = document.createElement('div');
  videoWrapper.classList.add('banner-video-wrapper');

  const video = document.createElement('video');
  video.classList.add('banner-video', 'banner-w-100', 'banner-object-fit-cover', 'banner-media');
  video.setAttribute('title', 'Video');
  video.setAttribute('aria-label', 'Video');
  video.setAttribute('data-is-autoplay', 'true');
  video.setAttribute('playsinline', '');
  video.setAttribute('preload', 'metadata');
  video.setAttribute('fetchpriority', 'high');
  video.setAttribute('loop', 'false');
  video.setAttribute('muted', 'true');
  video.setAttribute('autoplay', 'true');

  const source = document.createElement('source');
  source.setAttribute('type', 'video/mp4');

  const videoControls = document.createElement('div');
  videoControls.classList.add('banner-video-controls', 'banner-position-absolute', 'banner-w-100', 'banner-h-100', 'banner-start-0', 'banner-top-0', 'banner-d-flex', 'banner-justify-content-center', 'banner-align-items-center', 'banner-cursor-pointer');

  const playButton = document.createElement('button');
  playButton.setAttribute('type', 'button');
  playButton.classList.add('banner-video-icon-play', 'banner-d-none', 'banner-video-icon', 'banner-icon-play', 'banner-bg-transparent', 'banner-d-flex', 'banner-align-items-center', 'banner-justify-content-center', 'banner-cursor-pointer');

  const pauseButton = document.createElement('button');
  pauseButton.setAttribute('type', 'button');
  pauseButton.classList.add('banner-video-icon-pause', 'banner-d-block', 'banner-video-icon', 'banner-icon-pause', 'banner-bg-transparent', 'banner-d-flex', 'banner-align-items-center', 'banner-justify-content-center', 'banner-cursor-pointer');

  const muteIconDiv = document.createElement('div');
  muteIconDiv.classList.add('banner-mute-icon', 'banner-position-absolute', 'banner-z-2', 'banner-d-flex', 'banner-justify-content-center', 'banner-align-items-center', 'banner-cursor-pointer');

  const volumeMuteButton = document.createElement('button');
  volumeMuteButton.setAttribute('type', 'button');
  volumeMuteButton.classList.add('banner-video-icon-volume', 'banner-icon-mute', 'banner-bg-transparent', 'banner-d-flex', 'banner-align-items-center', 'banner-justify-content-center', 'banner-cursor-pointer', 'banner-d-none');

  const volumeUnmuteButton = document.createElement('button');
  volumeUnmuteButton.setAttribute('type', 'button');
  volumeUnmuteButton.classList.add('banner-video-icon-volume', 'banner-icon-unmute', 'banner-bg-transparent', 'banner-d-flex', 'banner-align-items-center', 'banner-justify-content-center', 'banner-cursor-pointer', 'banner-d-none');

  const noAudioButton = document.createElement('button');
  noAudioButton.setAttribute('type', 'button');
  noAudioButton.classList.add('banner-video-icon-volume', 'banner-no-audio-icon', 'banner-bg-transparent', 'banner-d-flex', 'banner-align-items-center', 'banner-justify-content-center', 'banner-cursor-pointer');

  const ctaWrapper = document.createElement('div');
  ctaWrapper.classList.add('banner-cta-wrapper', 'banner-position-absolute', 'banner-start-50', 'banner-translate-middle-x', 'banner-w-100', 'banner-boing__banner--cta');

  const cta = document.createElement('div');
  cta.classList.add('banner-cta');

  // Assuming the block has only one row with cells for each field
  const row = block.children[0];
  if (row) {
    moveInstrumentation(row, wrapper);
    const cells = [...row.children];

    // Extract content based on the order defined in the block JSON or assumed order
    // videoSrc is the first cell
    const videoSrcCell = cells[0];
    if (videoSrcCell) {
      const videoLink = videoSrcCell.querySelector('a');
      if (videoLink) {
        source.src = videoLink.href;
        moveInstrumentation(videoLink, source);
      }
    }

    // playIcon is the second cell
    const playIconCell = cells[1];
    if (playIconCell) {
      const playImg = playIconCell.querySelector('img');
      if (playImg) {
        playButton.innerHTML = `<img src="${playImg.src}" alt="${playImg.alt || 'Play'}">`;
        moveInstrumentation(playImg, playButton.querySelector('img'));
      } else {
        playButton.textContent = playIconCell.textContent.trim();
      }
    }

    // pauseIcon is the third cell
    const pauseIconCell = cells[2];
    if (pauseIconCell) {
      const pauseImg = pauseIconCell.querySelector('img');
      if (pauseImg) {
        pauseButton.innerHTML = `<img src="${pauseImg.src}" alt="${pauseImg.alt || 'Pause'}">`;
        moveInstrumentation(pauseImg, pauseButton.querySelector('img'));
      } else {
        pauseButton.textContent = pauseIconCell.textContent.trim();
      }
    }

    // muteIcon is the fourth cell
    const muteIconCell = cells[3];
    if (muteIconCell) {
      const muteImg = muteIconCell.querySelector('img');
      if (muteImg) {
        volumeMuteButton.innerHTML = `<img src="${muteImg.src}" alt="${muteImg.alt || 'Mute'}">`;
        moveInstrumentation(muteImg, volumeMuteButton.querySelector('img'));
      } else {
        volumeMuteButton.textContent = muteIconCell.textContent.trim();
      }
    }

    // unmuteIcon is the fifth cell
    const unmuteIconCell = cells[4];
    if (unmuteIconCell) {
      const unmuteImg = unmuteIconCell.querySelector('img');
      if (unmuteImg) {
        volumeUnmuteButton.innerHTML = `<img src="${unmuteImg.src}" alt="${unmuteImg.alt || 'Unmute'}">`;
        moveInstrumentation(unmuteImg, volumeUnmuteButton.querySelector('img'));
      } else {
        volumeUnmuteButton.textContent = unmuteIconCell.textContent.trim();
      }
    }

    // noAudioIcon is the sixth cell
    const noAudioIconCell = cells[5];
    if (noAudioIconCell) {
      const noAudioImg = noAudioIconCell.querySelector('img');
      if (noAudioImg) {
        noAudioButton.innerHTML = `<img src="${noAudioImg.src}" alt="${noAudioImg.alt || 'No Audio'}">`;
        moveInstrumentation(noAudioImg, noAudioButton.querySelector('img'));
      } else {
        noAudioButton.textContent = noAudioIconCell.textContent.trim();
      }
    }
  }

  video.append(source);
  videoWrapper.append(video);

  videoControls.append(playButton, pauseButton);
  videoWrapper.append(videoControls);

  muteIconDiv.append(volumeMuteButton, volumeUnmuteButton, noAudioButton);
  videoWrapper.append(muteIconDiv);

  wrapper.append(videoWrapper);

  ctaWrapper.append(cta);
  wrapper.append(ctaWrapper);

  block.textContent = '';
  block.append(wrapper);
}
