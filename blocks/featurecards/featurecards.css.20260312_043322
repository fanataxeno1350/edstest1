.featurecards-wrapper {
  padding: 1.5rem 1rem 1rem; /* Equivalent to 24px 16px 16px assuming 16px base */
  position: relative;
}
.featurecards-wrapper .featurecards-text-container {
  font-family: Barlow;
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  font-weight: 700;
  line-height: 1.75rem; /* Equivalent to 28px assuming 16px base */
  padding-bottom: 1rem; /* Equivalent to 16px assuming 16px base */
}
.featurecards-wrapper .featurecards-text-container .featurecards-title-highlight {
  color: #aa1f30;
}
.featurecards-wrapper .featurecards-boltesitare-card-section {
  border-radius: 0.75rem; /* Equivalent to 12px assuming 16px base */
  box-shadow: 0.125rem 0.25rem 1rem 0 rgba(0, 0, 0, 0.22); /* Equivalent to 2px 4px 16px 0 rgba(0, 0, 0, 0.22) assuming 16px base */
  margin-bottom: 1rem; /* Equivalent to 16px assuming 16px base */
  padding: 0.75rem 1.125rem 0.75rem 0.75rem; /* Equivalent to 12px 18px 12px 12px assuming 16px base */
  position: relative;
  z-index: 11;
}
.featurecards-wrapper .featurecards-boltesitare-card-section:first-of-type {
  padding-top: 1.25rem; /* Equivalent to 20px assuming 16px base */
}
.featurecards-wrapper .featurecards-boltesitare-card-section:last-of-type {
  margin-bottom: 3.375rem; /* Equivalent to 54px assuming 16px base */
}
.featurecards-wrapper .featurecards-boltesitare-card-section--wrapper {
  gap: 0.75rem; /* Equivalent to 12px assuming 16px base */
  display: flex;
}
.featurecards-wrapper .featurecards-boltesitare-card-section .featurecards-content-wrapper {
  flex: 1;
}
.featurecards-wrapper .featurecards-boltesitare-card-section--img {
  border-radius: 0.25rem; /* Equivalent to 4px assuming 16px base */
  height: 6.8125rem; /* Equivalent to 109px assuming 16px base */
  width: 8.3125rem; /* Equivalent to 133px assuming 16px base */
}
.featurecards-wrapper .featurecards-boltesitare-card-section--img .featurecards-card-img {
  border-radius: 0.25rem; /* Equivalent to 4px assuming 16px base */
  height: 100%;
  width: 100%;
}
.featurecards-wrapper .featurecards-boltesitare-card-section--title {
  padding-bottom: 0.25rem; /* Equivalent to 4px assuming 16px base */
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 700;
  line-height: normal;
  color: #030303;
}
.featurecards-wrapper .featurecards-boltesitare-card-section--text {
  font-family: Barlow;
  font-size: 0.75rem; /* Equivalent to 12px assuming 16px base */
  font-weight: 400;
  line-height: normal;
  color: #030303;
}
.featurecards-wrapper .featurecards-boltesitare-card-section--btn {
  background-color: #aa1f30;
  border-radius: 6.25rem; /* Equivalent to 100px assuming 16px base */
  cursor: pointer;
  height: 1.8125rem; /* Equivalent to 29px assuming 16px base */
  line-height: 1.8125rem; /* Equivalent to 29px assuming 16px base */
  padding: 0 1rem; /* Equivalent to 0px 16px assuming 16px base */
  text-align: center;
  text-decoration: none;
  color: #ffffff;
  font-family: Barlow;
  font-size: 0.75rem; /* Equivalent to 12px assuming 16px base */
  font-weight: 600;
}
.featurecards-wrapper .featurecards-curve-container {
  background-color: #ffffff;
  border-radius: 0 0 2rem 2rem; /* Equivalent to 0px 0px 32px 32px assuming 16px base */
  bottom: -3.6875rem; /* Equivalent to -59px assuming 16px base */
  height: 6.25rem; /* Equivalent to 100px assuming 16px base */
  overflow: hidden;
  position: absolute;
  right: 0;
  transform: skewY(-6.2deg);
  width: 100%;
  z-index: 10;
}
.featurecards-wrapper .featurecards-card-section {
  margin-inline: auto;
  padding-bottom: 1.5rem; /* Equivalent to 24px assuming 16px base */
}
.featurecards-wrapper .featurecards-card-section .featurecards-flex-column {
  display: flex;
  flex-direction: column;
  text-decoration: none;
}
.featurecards-wrapper .featurecards-card-section .featurecards-feature_card--image {
  height: 12.0625rem; /* Equivalent to 193px assuming 16px base */
  width: 100%;
  padding-bottom: 0.75rem; /* Equivalent to 12px assuming 16px base */
}
.featurecards-wrapper .featurecards-card-section .featurecards-feature_card--image .featurecards-w-100 {
  width: 100%;
}
.featurecards-wrapper .featurecards-card-section .featurecards-feature_card--image .featurecards-h-100 {
  height: 100%;
}
.featurecards-wrapper .featurecards-card-section .featurecards-text-center {
  text-align: center;
}
.featurecards-wrapper .featurecards-card-section .featurecards-feature_card--title {
  color: #aa1f30;
  margin-bottom: 0.25rem; /* Equivalent to 4px assuming 16px base */
  font-family: Barlow;
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  font-weight: 700;
  line-height: normal;
}
.featurecards-wrapper .featurecards-card-section .featurecards-pb-5 {
  padding-bottom: 1rem; /* Equivalent to 16px assuming 16px base */
}
.featurecards-wrapper .featurecards-card-section .featurecards-feature_card--desc {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  font-family: Barlow;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: normal;
  color: #030303;
}
.featurecards-wrapper .featurecards-card-section .featurecards-redirected_btn {
  display: none;
}
.featurecards-wrapper .featurecards-card-section .featurecards-arrow-icon-btn {
  background-color: #aa1f30;
  border-radius: 50%;
  cursor: pointer;
  height: 2.5rem; /* Equivalent to 40px assuming 16px base */
  width: 2.5rem; /* Equivalent to 40px assuming 16px base */
}
